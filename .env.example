DOCFLOW_ENVIRONMENT=development
DOCFLOW_LOG_LEVEL=INFO
DOCFLOW_API_HOST=0.0.0.0
DOCFLOW_API_PORT=8000
DOCFLOW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DOCFLOW_DATABASE_URL=sqlite+aiosqlite:///./storage/docflow.db
DOCFLOW_AUTO_CREATE_SCHEMA=true
DOCFLOW_STORAGE_ROOT=./storage
# DOCFLOW_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
DOCFLOW_OCR_LANGUAGES=rus+eng
DOCFLOW_REDIS_URL=redis://localhost:6379/0

DOCFLOW_S3_ENDPOINT=http://localhost:9000
DOCFLOW_S3_ACCESS_KEY=docflow
DOCFLOW_S3_SECRET_KEY=docflow-secret
DOCFLOW_S3_BUCKET=documents

DOCFLOW_LLM_PROVIDER=mock
DOCFLOW_ANTHROPIC_API_KEY=
DOCFLOW_ANTHROPIC_MODEL=
DOCFLOW_AUTO_ACCEPT_THRESHOLD=0.85
DOCFLOW_JWT_SECRET=replace-in-production

VITE_API_URL=http://localhost:8000
